VERSION="0.2.1"
AUTHOR="LKML"
HOMEPAGE="https://tharidulakmal.com"

# ---------- help / version ----------
show_help() {
  cat <<EOF
ytd — Terminal YouTube Downloader

Usage:
  ytd                      Launch interactive TUI
  ytd mp3 <url>            Download single video as MP3
  ytd video <url>          Download single video (MP4)
  ytd mp3-playlist <url>   Download playlist as MP3
  ytd video-playlist <url> Download playlist as video

Options:
  -h, --help       Show this help message
  -v, --version    Show version information

Author:
  $AUTHOR
  $HOMEPAGE
EOF
}

show_version() {
  echo "ytd v$VERSION"
  echo "by $AUTHOR"
  echo "$HOMEPAGE"
}

case "${1:-}" in
  -h|--help)
    show_help
    exit 0
    ;;
  -v|--version)
    show_version
    exit 0
    ;;
esac


k#!/usr/bin/env bash
set -euo pipefail

DOWNLOAD_DIR="$HOME/Downloads"

# ---------- helpers ----------
die() {
  echo "ytd: $1" >&2
  exit 1
}

require() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}

# ---------- dependencies ----------
require yt-dlp
require ffmpeg
require gum

# ---------- CLI MODE ----------
if [[ $# -ge 2 ]]; then
  MODE="$1"
  URL="$2"

  [[ ! "$URL" =~ youtube\.com|youtu\.be ]] && die "invalid YouTube URL"

  case "$MODE" in
    mp3)
      yt-dlp --no-playlist -x --audio-format mp3 \
        -o "$DOWNLOAD_DIR/%(title)s.%(ext)s" "$URL"
      exit 0
      ;;
    video)
      yt-dlp --no-playlist --merge-output-format mp4 \
        -o "$DOWNLOAD_DIR/%(title)s.%(ext)s" "$URL"
      exit 0
      ;;
    mp3-playlist)
      yt-dlp -x --audio-format mp3 \
        -o "$DOWNLOAD_DIR/%(playlist)s/%(title)s.%(ext)s" "$URL"
      exit 0
      ;;
    video-playlist)
      yt-dlp --merge-output-format mp4 \
        -o "$DOWNLOAD_DIR/%(playlist)s/%(title)s.%(ext)s" "$URL"
      exit 0
      ;;
    *)
      die "unknown mode: $MODE"
      ;;
  esac
fi

# ---------- TUI MODE ----------
clear

gum style \
  --border rounded \
  --padding "1 2" \
  --bold \
  "ytd — Terminal YouTube Downloader
by LKML • tharidulakmal.com"

MODE=$(gum choose \
  "🎬 Video (single)" \
  "📺 Video (playlist)" \
  "🎵 MP3 (single)" \
  "📀 MP3 (playlist)" \
  "❌ Exit")

[[ "$MODE" == "❌ Exit" || -z "$MODE" ]] && exit 0

URL=$(gum input --placeholder "Paste YouTube URL")

[[ ! "$URL" =~ youtube\.com|youtu\.be ]] && {
  gum style --foreground 196 "Invalid YouTube URL"
  exit 1
}

FORMAT=""
QUALITY=""

if [[ "$MODE" == *Video* ]]; then
  FORMAT=$(gum choose "MP4 (recommended)" "WebM (original)")
  QUALITY=$(gum choose "Best" "1080p" "720p")
fi

CMD=(yt-dlp)

case "$MODE" in
  "🎬 Video (single)")
    CMD+=(--no-playlist)
    [[ "$QUALITY" == "1080p" ]] && CMD+=(-f "bv*[height<=1080]+ba/b")
    [[ "$QUALITY" == "720p" ]]  && CMD+=(-f "bv*[height<=720]+ba/b")
    [[ "$FORMAT" == "MP4 (recommended)" ]] && CMD+=(--merge-output-format mp4)
    CMD+=(-o "$DOWNLOAD_DIR/%(title)s.%(ext)s" "$URL")
    ;;
  "📺 Video (playlist)")
    [[ "$FORMAT" == "MP4 (recommended)" ]] && CMD+=(--merge-output-format mp4)
    CMD+=(-o "$DOWNLOAD_DIR/%(playlist)s/%(title)s.%(ext)s" "$URL")
    ;;
  "🎵 MP3 (single)")
    CMD+=(--no-playlist -x --audio-format mp3)
    CMD+=(-o "$DOWNLOAD_DIR/%(title)s.%(ext)s" "$URL")
    ;;
  "📀 MP3 (playlist)")
    CMD+=(-x --audio-format mp3)
    CMD+=(-o "$DOWNLOAD_DIR/%(playlist)s/%(title)s.%(ext)s" "$URL")
    ;;
esac

gum confirm "Download to $DOWNLOAD_DIR ?" || exit 0

echo "Downloading…"
"${CMD[@]}" 2>&1 | grep --line-buffered "\[download\]" | while IFS= read -r line; do
  # Match: [download]   75.3% of  143.20MiB in 00:00:10 at 10.53MiB/s
  if [[ "$line" =~ [[:space:]]([0-9]+(\.[0-9]+)?)%.*at[[:space:]]+([0-9]+(\.[0-9]+)?[A-Za-z]+/s) ]]; then
    percent="${BASH_REMATCH[1]%.*}"   # strip decimals for bar math
    percent_disp="${BASH_REMATCH[1]}" # keep original for display
    speed="${BASH_REMATCH[3]}"

    # Clamp to 50 cols
    filled=$(( percent > 100 ? 50 : percent / 2 ))
    empty=$(( 50 - filled ))
    bar=$(printf '%0.s█' $(seq 1 $filled) 2>/dev/null || printf '%*s' "$filled" '' | tr ' ' '█')
    empty_bar=$(printf '%*s' "$empty" '' | tr ' ' '░')

    # \r to overwrite same line, no newline
    printf "\r  [%s%s] %5s%% │ %s        " "$bar" "$empty_bar" "$percent_disp" "$speed"

  # Destination line — print filename above the bar
  elif [[ "$line" =~ Destination:[[:space:]](.+) ]]; then
    filename=$(basename "${BASH_REMATCH[1]}")
    printf "\n  ↓ %s\n" "$filename"

  # Merger line — print status
  elif [[ "$line" =~ \[Merger\] ]]; then
    printf "\n  ⚙  Merging formats…\n"
  fi
done

echo  # newline after progress bar
gum style --foreground 42 --bold "✔ Download finished"